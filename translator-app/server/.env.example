# -------------------------------------------------------
# MyMemory Translation API — optional configuration
# -------------------------------------------------------

# Port the Express server listens on (default: 5000)
PORT=5000

# (Optional) Your email address.
# Providing it raises MyMemory's free daily limit from
# 5,000 words/day to 50,000 words/day. No account needed —
# just drop your email here and MyMemory tracks the quota against it.
# Leave blank to use the anonymous (5,000 word) limit.
MYMEMORY_EMAIL=
